  "schemaVersion": 3,
  "world": "emerald-valley",
  "policy": {
    "qualityFirst": true,
    "licensePriority": ["CC0", "clearly-commercial-safe"],
    "redistributableStandaloneAssets": false,
    "runtimeBrains": 1,
    "mobileFirst": true,
    "sourceOnlyUntilValidated": true,
    "representationStrategy": "best-fit-per-scene",
    "allowedRepresentations": ["2d", "2.5d", "3d"]
  },
  "selectionRules": {
    "prefer3dWhen": ["close_interaction", "free_camera", "spatial_occlusion", "reusable_modular_world"] ,
    "prefer2_5dWhen": ["parallax_background", "map_landmark", "distant_building", "decorative_depth"],
    "prefer2dWhen": ["icons", "sprites", "portraits", "small_particles", "far_background", "low_cost_decoration"],
    "neverForceOneRepresentation": true,
    "reuseAcrossRepresentations": true
  },
